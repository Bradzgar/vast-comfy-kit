# Copy this file to "env" and fill in your values. NEVER commit "env".
#   cp env.example env
#
# ============================ TOKENS ============================
# Hugging Face token (Read is enough). The account behind it MUST have accepted
# the licenses at https://huggingface.co/krea/Krea-2-Raw and .../Krea-2-Turbo.
HF_TOKEN=

# Civitai API key (needed for NSFW / restricted model downloads).
CIVITAI_API_KEY=

# ============================ LAYOUT ============================
WORKSPACE=/workspace
MODELS_DIR=/workspace/models
COMFY_DIR=/workspace/ComfyUI
TOOLKIT_DIR=/workspace/ai-toolkit
HF_CACHE=/workspace/cache/huggingface
COMFY_PORT=8188

# ============================ BUILD OPTIONS ============================
# PyTorch wheel index. Leave blank to auto-detect:
#   Blackwell (compute_cap >= 12)  -> cu130
#   everything else                -> cu128
# Override only if you know better, e.g. https://download.pytorch.org/whl/cu128
TORCH_INDEX=

# Pin a ComfyUI tag/branch/sha for reproducibility. Blank = track master.
# Your local machine ran v0.39.0.
COMFY_REF=

# Install Ostris AI Toolkit for Krea 2 LoRA training (1 = yes).
INSTALL_TOOLKIT=1

# Download the gated Krea-2-Raw training base (~25 GB) into MODELS_DIR/krea2-raw.
# Requires HF_TOKEN + accepted license. 1 = download on first boot.
FETCH_TRAIN_BASE=0

# Download ComfyUI models on start (1 = yes). Set 0 for a fast restart check.
FETCH_MODELS=1
